{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DanielLemky/omalaunch-extensions/main/schema.json",
  "title": "Omalaunch Extension Directory",
  "type": "object",
  "required": ["extensions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "$defs": {
    "extension": {
      "type": "object",
      "required": ["id", "name", "description", "author", "repository", "prefixes"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "omarchyPluginsUrl": {
          "type": "string",
          "pattern": "^https://omarchyplugins\\.com/"
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
