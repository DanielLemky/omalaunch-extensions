{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DanielLemky/omalaunch-extensions/master/schema.json",
  "title": "Omalaunch Extension Directory",
  "type": "object",
  "required": ["schemaVersion", "extensions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "extensions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "$defs": {
    "shortText": { "type": "string", "minLength": 1, "maxLength": 256 },
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "extension": {
      "type": "object",
      "required": ["id", "name", "description", "author", "repository", "capabilities", "modes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "$ref": "#/$defs/shortText" },
        "description": { "type": "string", "minLength": 1, "maxLength": 512 },
        "author": { "$ref": "#/$defs/shortText" },
        "repository": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "omarchyPluginsUrl": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://omarchyplugins\\.com/[A-Za-z0-9_./-]+/?$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["prefix", "query", "files", "workflow", "menu"] }
        },
        "prefixes": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
